{
  "name": "sharesight-mcp",
  "version": "0.0.0-dev",
  "description": "MCP server for Sharesight v3 API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "sharesight-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node scripts/clean-test-build.mjs && tsc -p tsconfig.test.json && node --test \".test-build/**/*.test.js\" \"scripts/*.test.mjs\"",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "keywords": [
    "mcp",
    "sharesight",
    "api",
    "investment",
    "portfolio"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/lethek/sharesight-mcp.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
