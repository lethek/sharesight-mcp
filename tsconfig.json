{
  "compilerOptions": {
    "target": "ES2025",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2025"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", ".test-build"]
}
